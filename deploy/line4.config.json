// PVS Line 4 config TEMPLATE. Copy to C:\PvsLineApp\line.config.json on LINE4PVS at deploy.
// Prepared 2026-08-06 for a LINE4PVS that comes up 2026-08-07. Line 4 is a Sony line (F130/F209), same
// pattern as Lines 1/2/5.
// TODO at deploy (do these on the actual Line 4 PC):
//   (1) CONFIRM COM->machine map. The WCH PCI-E serial card enumerates COM numbers differently per PC
//       (this bit Lines 2 & 5). Check Device Manager / test each port; M4 MUST be the physically LAST
//       machine (PCB-out). The ports below are the Line 1 mapping as a starting guess only.
//   (2) Set central.server to the Line 4 PC's best path to the Parts DB: LAN 192.168.0.134,1433 if wired
//       to that subnet, else Tailscale 100.91.120.113,1433.
//   (3) db-password.txt (the 4-char pvs_ro secret) is COPIED from Line 1, NOT stored here.
//   (4) Confirm which models run on Line 4 and that their ProductBOM has Line-4 rows (BOM gap = no verify).
//   (5) Pilot: keep syncStockOuts + writeProductionCount OFF until the operator-app / DPC handover (like L1).
{
  "lineId": 4,
  "lineName": "LINE4PVS",

  "shiftTimes": [
    { "name": "Day",   "start": "07:35", "end": "19:35" },
    { "name": "Night", "start": "19:35", "end": "07:35" }
  ],

  // PLACEHOLDER ports = Line 1 mapping. CONFIRM on LINE4PVS before go-live. M4 = physically last (PCB-out).
  "machines": [
    { "machine": 1, "port": "COM5", "model": "F130", "hasTrayFeeder": false },
    { "machine": 2, "port": "COM4", "model": "F130", "hasTrayFeeder": false },
    { "machine": 3, "port": "COM6", "model": "F209", "hasTrayFeeder": true  },
    { "machine": 4, "port": "COM3", "model": "F209", "hasTrayFeeder": true  }
  ],

  "serial":   { "baudRate": 9600, "dataBits": 7, "parity": "Even", "stopBits": 1 },
  "forecast": { "redMinutes": 45, "amberMinutes": 120 },

  // Superset of models across the plant (extra factors are harmless; only the running model is used).
  "panelBoards": { "L254": 4, "L261": 6, "L264": 6, "L307": 4, "L309": 4, "L311": 4, "L313": 4, "L347": 4 },

  // Set to the fastest working path from LINE4PVS. Password stays empty; app reads db-password.txt (from Line 1).
  "central": { "server": "192.168.0.134,1433", "database": "ReelPart-New", "userId": "pvs_ro", "password": "" },

  "badge": { "uidPrefix": "9999" },

  // Delivery robot: PVS calls the MCS dispatcher on the NAS (the only thing that talks to the robot). Empty = hidden.
  "robot": { "dispatcherUrl": "http://192.168.0.169:8090" },

  // writeProductionCount ON — PVS is the DPC writer for this line (external logger 192.168.0.190 died 2026-08-14).
  // Do NOT let a redeploy revert it to false: that silently stops production recording.
  "syncStockOuts": false,
  "writeProductionCount": true
}
