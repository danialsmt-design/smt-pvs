// PVS Line 1 config — mirrors the LIVE C:\PvsLineApp\line.config.json (refreshed 2026-07-30).
// Only lineId, lineName, and machines[] differ between lines; everything else is factory-wide.
// (The app parser allows // comments and trailing commas.)
{
  "lineId": 1,
  "lineName": "LINE1PVS",

  "shiftTimes": [
    { "name": "Day",   "start": "07:30", "end": "19:30" },
    { "name": "Night", "start": "19:30", "end": "07:30" }
  ],

  // COM ports are per-PC and re-number on reboot — discover on THIS PC (see runbook §2).
  // M4 must be the physically LAST machine on the line (board count + lot progress come off it).
  "machines": [
    { "machine": 1, "port": "COM5", "model": "F130", "hasTrayFeeder": false },
    { "machine": 2, "port": "COM4", "model": "F130", "hasTrayFeeder": false },
    { "machine": 3, "port": "COM6", "model": "F209", "hasTrayFeeder": true  },
    { "machine": 4, "port": "COM3", "model": "F209", "hasTrayFeeder": true  }
  ],

  "serial":   { "baudRate": 9600, "dataBits": 7, "parity": "Even", "stopBits": 1 },
  "forecast": { "redMinutes": 45, "amberMinutes": 120 },

  // Child boards per panel, by model (one machine cycle = one panel). Wrong value => count off by this factor.
  "panelBoards": { "L254": 4, "L261": 6, "L264": 6, "L307": 4, "L309": 4, "L311": 4, "L313": 4, "L347": 4 },

  // Shared Parts DB (Parts PC over Tailscale). Password lives in C:\PvsLineApp\db-password.txt, not here.
  "central": { "server": "100.91.120.113,1433", "database": "ReelPart-New", "userId": "pvs_ro", "password": "" },

  "badge": { "uidPrefix": "9999" },

  "syncStockOuts": true,          // Line 1: balances trusted, writing live remaining to StockOuts.Quantity
  "writeProductionCount": true,   // Line 1: PVS is the DPC writer (operator app stopped 2026-07-31); 5-min buckets per lot/side
  "c1zShadow": true,              // OBSERVE-ONLY: log C1Z pickup-consumption vs PVS per-board decrement (no stock written). Validate the F114 gap.
  "c1zDecrement": false,          // do NOT apply the C1Z model to stock yet — turn on only after shadow confirms

  // Forward-looking parts-shortage check: which upcoming lot runs a part out, emailed with lead time.
  // FACTORY-WIDE report — enable on EXACTLY ONE line or the manager gets five identical copies. Line 1 is
  // the natural host (it is the email gateway) but nothing in the code assumes that; the role can move.
  // Recipients come from email.recipients and are picked by their role text (see recipientRoles).
  "shortageMonitor": {
    "enabled": false,             // <-- turn on for one line only
    "dailyTime": "07:45",
    "leadTimeDays": 2,            // a lot due within this many days makes the shortage URGENT
    "horizonDays": 21,
    "reelDaysBack": 30,           // reels issued longer ago than this are not counted as still at the line
    "reelFreshHours": 72,
    "reminderHours": 24,          // an unchanged, still-outstanding shortage repeats at most this often
    "materialChangePercent": 5,
    "allClearDays": 0,            // 0 = never send a "nothing is short" email
    "recipientRoles": [ "production", "parts", "material", "planner", "manager" ]
  }
}
