// PVS Line 3 config TEMPLATE. Copy to C:\PvsLineApp\line.config.json on the Line 3 PC.
// TODO before go-live: (1) discover the real COM ports on this PC (runbook §2);
//   (2) confirm machine F130/F209 layout; (3) audit ProductBOM for Line 3 (runbook §4).
// Line 3 runs (per ProductBOM, 2026-07-30): L261 (A & B), L264 (A & B), and L254 as a
//   SINGLE-SIDED board stored as Side='Full' (50 feeders). The feeder query already resolves
//   "A"/"B" to include 'Full', so L254 loads on whichever side auto-detect reports — no code change needed.
{
  "lineId": 3,
  "lineName": "LINE3PVS",

  "shiftTimes": [
    { "name": "Day",   "start": "07:35", "end": "19:35" },
    { "name": "Night", "start": "19:35", "end": "07:35" }
  ],

  // ⚠ PLACEHOLDER ports copied from Line 1 — DISCOVER the real mapping on the Line 3 PC and edit.
  // M4 must be the physically LAST machine on the line.
  "machines": [
    { "machine": 1, "port": "COM5", "model": "F130", "hasTrayFeeder": false },
    { "machine": 2, "port": "COM4", "model": "F130", "hasTrayFeeder": false },
    { "machine": 3, "port": "COM6", "model": "F209", "hasTrayFeeder": true  },
    { "machine": 4, "port": "COM3", "model": "F209", "hasTrayFeeder": true  }
  ],

  "serial":   { "baudRate": 9600, "dataBits": 7, "parity": "Even", "stopBits": 1 },
  "forecast": { "redMinutes": 45, "amberMinutes": 120 },

  // Confirm the factors for THIS line's models (L254, L261, L264). L254 is single-sided (Full) — verify its factor.
  "panelBoards": { "L254": 4, "L261": 6, "L264": 6, "L307": 4, "L309": 4, "L311": 4, "L313": 4, "L347": 4 },

  "central": { "server": "100.91.120.113,1433", "database": "ReelPart-New", "userId": "pvs_ro", "password": "" },

  "badge": { "uidPrefix": "9999" },

  // Delivery robot: PVS calls the MCS dispatcher on the NAS (the only thing that talks to the robot). Empty = hidden.
  "robot": { "dispatcherUrl": "http://192.168.0.169:8090" },

  // writeProductionCount ON — PVS is the DPC writer for this line (external logger 192.168.0.132 died 2026-08-11).
  // Do NOT let a redeploy revert it to false: that silently stops production recording.
  "syncStockOuts": false,
  "writeProductionCount": true
}
